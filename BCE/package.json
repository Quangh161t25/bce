{
  "name": "bce-management-system",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"fs.copyFileSync('dist/template.html', 'dist/index.html')\"",
    "build:single": "node -e \"process.env.SINGLE_FILE='true'\" && vite build && node -e \"fs.copyFileSync('dist/template.html', 'index.html'); fs.copyFileSync('dist/template.html', 'dist/index.html')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "jsrsasign": "^11.1.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
