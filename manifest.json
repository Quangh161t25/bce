{
  "manifest_version": 3,
  "name": "Shopee Quản Lý SP",
  "version": "0.2.0",
  "description": "Ho tro thao tac tren Shopee Kenh Nguoi Ban.",
  "icons": {
    "16": "extension/icons/icon-16.png",
    "32": "extension/icons/icon-32.png",
    "48": "extension/icons/icon-48.png",
    "128": "extension/icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "downloads",
    "storage",
    "unlimitedStorage",
    "scripting",
    "sidePanel",
    "tabs",
    "contextMenus",
    "cookies",
    "notifications",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://banhang.shopee.vn/*",
    "https://shopee.vn/*",
    "https://*.susercontent.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.vercel.app/*",
      "https://*.netlify.app/*",
      "https://*.pages.dev/*",
      "https://*.github.io/*",
      "https://*.web.app/*",
      "https://*.firebaseapp.com/*",
      "https://*.onrender.com/*",
      "https://*.wameli.vn/*"
    ]
  },
  "action": {
    "default_title": "Shopee Quản Lý SP",
    "default_icon": {
      "16": "extension/icons/icon-16.png",
      "32": "extension/icons/icon-32.png",
      "48": "extension/icons/icon-48.png",
      "128": "extension/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "side_panel": {
    "default_path": "extension/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.vn/*",
        "https://banhang.shopee.vn/*"
      ],
      "js": [
        "extension/content/shopee-fetch-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.vn/*"
      ],
      "js": [
        "extension/content/content-start.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://banhang.shopee.vn/*",
        "https://shopee.vn/*"
      ],
      "js": [
        "extension/lib/xlsx.full.min.js",
        "extension/lib/pdf-lib.min.js",
        "extension/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://banhang.shopee.vn/*"
      ],
      "js": [
        "extension/autochat/token.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://banhang.shopee.vn/*"
      ],
      "js": [
        "extension/roas-that/roas-that.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://banhang.shopee.vn/webchat/*",
        "https://banhang.shopee.vn/new-webchat/*"
      ],
      "js": [
        "extension/autochat/shared.js",
        "extension/autochat/content.js"
      ],
      "css": [
        "extension/autochat/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "extension/content/gemini-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "extension/content/chatgpt-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://phanmem.wameli.vn/*"
      ],
      "js": [
        "extension/content/wameli.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.xiapibuy.com/*",
        "*://*.shopee.co.id/*",
        "*://shopee.tw/*",
        "*://shopee.vn/*",
        "*://shopee.co.th/*",
        "*://shopee.ph/*",
        "*://shopee.com.my/*",
        "*://shopee.sg/*",
        "*://shopee.com.br/*",
        "*://shopee.com.mx/*",
        "*://shopee.com.co/*",
        "*://shopee.cl/*",
        "*://shopee.pl/*"
      ],
      "js": [
        "extension/tai-anh-shopee/js/jquery.min.js",
        "extension/tai-anh-shopee/js/load.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://gemini.google.com/*"
      ],
      "js": [
        "extension/tai-anh-shopee/js/aiAutoPaste.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extension/content/universal-image-hover.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shopee.vn/*"
      ],
      "js": [
        "extension/clone-tool/content/shopee-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://shopee.vn/*"
      ],
      "js": [
        "extension/clone-tool/content/shopee-relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "extension/clone-tool/content/ai-chat.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/*",
        "dist/assets/*",
        "extension/flash-sale/*",
        "extension/clone-tool/*",
        "extension/popup/images/*",
        "extension/content/shopee-fetch-interceptor.js",
        "extension/tai-anh-shopee/js/contentScript.js",
        "extension/tai-anh-shopee/index.html",
        "extension/tai-anh-shopee/assets/*",
        "extension/tai-anh-shopee/_locales/*",
        "extension/tai-anh-shopee/icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
