{
  "manifest_version": 3,
  "name": "Shopee Chat - Khách Chờ Trả Lời",
  "version": "2.0.0",
  "description": "Theo dõi khách nhắn mới qua API webchat Shopee, tự gửi câu chào và lập danh sách khách chờ để trả lời sau.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://banhang.shopee.vn/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://banhang.shopee.vn/webchat/*",
        "https://banhang.shopee.vn/new-webchat/*"
      ],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
